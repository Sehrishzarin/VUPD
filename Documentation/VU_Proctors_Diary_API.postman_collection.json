{
	"info": {
		"_postman_id": "vu-proctors-diary-api",
		"name": "VU Proctors Diary API",
		"description": "Complete API collection for VU Proctors Diary Management System\n\n**Base URL**: `http://localhost:5000/api`\n\n**Authentication**: Most endpoints require Bearer token authentication. Use the Login endpoint to get a token, then set it in the Authorization header.\n\n**Setup Instructions**:\n1. Import this collection into Postman\n2. Create an environment variable `base_url` with value `http://localhost:5000/api`\n3. Create an environment variable `token` (will be auto-set after login)\n4. Start with Authentication endpoints to get your token",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"cnic\": \"12345-1234567-1\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"invigilator\",\n  \"preferredCenter\": [\"Center A\", \"Center B\"],\n  \"qualification\": \"Masters\",\n  \"contact\": \"+923001234567\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Register a new user (invigilator, superintendent, or admin). Admin users can login immediately without approval."
					},
					"response": []
				},
				{
					"name": "Register Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Admin User\",\n  \"cnic\": \"12345-1234567-2\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\",\n  \"role\": \"admin\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Register a new admin user. Admin users can login immediately without approval."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('token', response.token);",
									"    pm.environment.set('userId', response.user.id);",
									"    pm.environment.set('userRole', response.user.role);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login and get authentication token. Token is automatically saved to environment variable."
					},
					"response": []
				}
			],
			"description": "Authentication endpoints for user registration and login"
		},
